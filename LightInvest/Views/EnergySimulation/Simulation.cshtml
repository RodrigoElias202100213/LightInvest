@using LightInvest.Models.Ener
@using LightInvest.Models.Simulacao.Energ
@using LightInvest.Models.Simulacao.Tarifa
@model EnergyConsumptionViewModel

@{
    ViewData["Title"] = "Consumo de Energia";
}

<div class="container">
    <div class="sidebar">
        <div class="steps">
            <div class="step">1</div>
            <div class="step">2</div>
            <div class="step">3</div>
            <div class="step">4</div>
        </div>
    </div>
    <div class="content">
        <h2>Formulário Consumo de Energia</h2>
        <p class="required-msg">Os campos marcados com <span class="required">*</span> são obrigatórios.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-controller="EnergySimulation" asp-action="Simulation" method="post">

            <!-- Consumo Horário Dias de Semana -->
            <div class="section">
                <div class="title-container">
                    <h5>1. Consumo Médio Horário: Segunda-feira a Sexta-feira <span class="required">*</span></h5>
                    <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Insira a quantidade média de energia consumida (em kWh) durante este horário nos dias úteis.">?</button>
                </div>

                <div class="horario">
                    @for (int i = 0; i < 24; i++)
                    {
                        <div class="hora">
                            <span>@i h</span>
                            <input type="number" asp-for="ConsumoDiaSemana[i]" min="0" step="0.01"
                                   value="@(Model.ConsumoDiaSemana[i] > 0 ? Model.ConsumoDiaSemana[i].ToString("F2") : "")" />
                        </div>
                    }
                </div>
            </div>

            <!-- Consumo Horário Fins de Semana -->
            <div class="section">
                <div class="title-container">
                    <h5>2. Consumo Médio Horário: Feriados/Fim de Semana <span class="required">*</span></h5>
                    <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Insira a quantidade média de energia consumida (em kWh) durante este horário nos fins de semana e feriados.">?</button>
                </div>

                <div class="horario">
                    @for (int i = 0; i < 24; i++)
                    {
                        <div class="hora">
                            <span>@i h</span>
                            <input type="number" asp-for="ConsumoFimSemana[i]" min="0" step="0.01"
                                   value="@(Model.ConsumoFimSemana[i] > 0 ? Model.ConsumoFimSemana[i].ToString("F2") : "")" />
                        </div>
                    }
                </div>
            </div>

            <!-- Ocupação Mensal -->

            <div class="section">
                <div class="title-container">

                <h5>3. Ocupação Mensal <span class="required">*</span></h5>
                <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Selecione os meses em que o imóvel fica habitado.">?</button>
                </div>
                <div class="month-checkboxes">
                    @foreach (var mes in Enum.GetNames(typeof(Meses)))
                    {
                        <label>
                            <input type="checkbox" name="MesesOcupacao" value="@mes"
                            @(Model.MesesOcupacao.Contains(mes) ? "checked" : "") />
                            @mes
                        </label>
                    }
                </div>
            </div>


            <div id="btn-container">
                <a href="@Url.Action("Index", "Home")" class="btn">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar e Continuar</button>
            </div>

        </form>
    </div>
</div>

<script>

      document.addEventListener('DOMContentLoaded', function () {
        $('[data-toggle="tooltip"]').tooltip();
    });

     document.addEventListener('DOMContentLoaded', function () {
        const inputs = document.querySelectorAll('input[type="number"]');

        inputs.forEach(input => {
            input.addEventListener('input', function () {
                let value = parseFloat(this.value);
                let errorMessage = this.parentElement.querySelector('.error-message');
                if (errorMessage) {
                    errorMessage.remove();
                }

                if (isNaN(value) || value < 0 || value > 500) {
                    errorMessage = document.createElement('span');
                    errorMessage.classList.add('error-message');
                    errorMessage.textContent = 'Valor entre 0 e 500!';
                    this.parentElement.appendChild(errorMessage);
                    this.setCustomValidity('O valor deve estar entre 0 e 500.');
                } else {
                    this.setCustomValidity('');
                }
            });
        });

        document.querySelector('form').addEventListener('submit', function (event) {
            inputs.forEach(input => {
                if (input.value.trim() === '') {
                    input.value = '0';
                }
            });
        });
    });

</script>


<style>

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
    }

    nav, header {
        margin: 0;
        padding: 0;
        width: 0%;
        height: 0%;
    }

    .title-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .container {
        display: flex;
        width: 100%;
        min-height: 100vh;
    }

    .sidebar {
        width: 20%;
        background-color: #d3e1e3;
        padding: 20px;
        position: relative;
    }

    .steps {
        position: absolute;
        top: 50px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .step {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #aaa;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        margin: 30px 0;
        position: relative;
    }

        .step:first-child {
            background-color: #065A66;
        }

        .step::after {
            content: "";
            width: 2px;
            height: 80px;
            background-color: #aaa;
            position: absolute;
            bottom: -80px;
            transform: translateX(-50%);
        }


        .step:last-child::after {
            display: none;
        }

    .content {
        width: 80%;
        padding: 20px;
    }

    h2 {
        font-weight: bold;
        font-size: 3rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #065A66;
        text-align: center;
        margin-bottom: 4%;
    }

    .section {
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 15px;
        margin: 10px 0;
        margin-bottom: 4%;
    }

    .horario {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 10px;
        row-gap: 30px;
        text-align: center;
    }

    .hora {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .hora input {
            width: 50px;
            text-align: center;
            border: none;
            border-bottom: 2px solid #000;
            background: transparent;
            outline: none;
            padding: 2px;
        }

    h5 {
        margin: 0;
        margin-top: 2%;
        margin-bottom: 2%;
        font-weight: bolder;
    }

    .month-checkboxes {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 10px;
    }

        .month-checkboxes label {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 5px;
        }

        .month-checkboxes input {
            width: 18px;
            height: 18px;
        }

    #btn-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 20px;
    }

    .btn {
        background: #065A66;
        color: white;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
        border-radius: 10px;
        text-decoration: none;
        text-align: center;
    }

        .btn:hover {
            background: #065A66;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
            border-radius: 10px;
            text-decoration: none;
            text-align: center;
        }

    .required {
        color: red;
        font-weight: bold;
    }

    .required-msg {
        font-size: 1rem;
        color: #065A66;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .alert {
        margin-top: 2%;
    }

    .error-message {
        color: red;
        font-size: 0.75rem; 
        white-space: nowrap;
        margin-left: 5px;
        font-weight: bold;
    }

    .info-btn {
        background: transparent;
        border: none;
        color: #065A66;
        font-size: 18px;
        cursor: pointer;
        margin-left: 10px; 


</style>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.0/dist/js/bootstrap.bundle.min.js"></script>
