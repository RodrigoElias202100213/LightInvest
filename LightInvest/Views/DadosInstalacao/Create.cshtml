@using LightInvest.Models.Ener
@model LightInvest.Models.DadosInstalacaoViewModel

@{
    ViewData["Title"] = "Solicitação de Instalação";
}

<div class="create-simulation">
    <div class="create-box">
        <div class="container">
            <div class="sidebar">
                <div class="steps">
                    <div class="step">1</div>
                    <div class="step">2</div>
                    <div class="step">3</div>
                    <div class="step">4</div>
                </div>
            </div>

            <div class="content">
                <h2>Simulação</h2>

                <p class="required-msg">Os campos marcados com <span class="required">*</span> são obrigatórios.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="left">
                    <form asp-action="Create" method="post">
                        <div class="form-group">
                            <label><strong>1. Cidade: <span class="required">*</span></strong></label>
                            <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Selecione a cidade onde será realizada a instalação.">?</button>

                            <select asp-for="CidadeId" class="form-control" required>
                                <option value="">Selecione a cidade</option>
                                @foreach (var cidade in Model.Cidades)
                                {
                                    <option value="@cidade.Id">@cidade.Nome</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="CidadeId"></span>
                        </div>

                        <div class="form-group">
                            <label><strong>2. Modelo do Painel Solar: <span class="required">*</span></strong></label>
                            <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Escolha um modelo de painel solar adequado às suas necessidades.">?</button>

                            <select id="modeloPainelSelect" asp-for="ModeloPainelId" class="form-control" required>
                                <option value="">Selecione o modelo</option>
                                @foreach (var modelo in Model.ModelosDePaineis)
                                {
                                    <option value="@modelo.Id">@modelo.ModeloNome - @modelo.Preco €</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="ModeloPainelId"></span>
                        </div>

                        <div class="form-group">
                            <label><strong>3. Potência do Painel: <span class="required">*</span></strong></label>
                            <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Selecione a potência do painel solar para determinar a produção de energia.">?</button>

                            <select id="consumoPainelSelect" asp-for="PotenciaId" class="form-control" required>
                                <option value="">Selecione a potência</option>
                                @foreach (var potencia in Model.Potencias)
                                {
                                    <option value="@potencia.Id">@potencia.Potencia W</option>
                                }
                            </select>
                            <span class="text-danger" asp-validation-for="PotenciaId"></span>
                        </div>

                        <div class="form-group">
                            <label><strong>4. Número de Painéis: <span class="required">*</span></strong></label>
                            <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Informe quantos painéis solares deseja instalar.">?</button>

                            <input asp-for="NumeroPaineis" class="form-control" type="number" min="1" max="1000" required />
                            <span class="text-danger" asp-validation-for="NumeroPaineis"></span>
                        </div>

                        <div class="form-group">
                            <label><strong>5. Inclinação (graus): <span class="required">*</span></strong></label>
                            <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Defina o ângulo de inclinação dos painéis para melhor captação de energia.">?</button>

                            <input asp-for="Inclinacao" class="form-control" type="number" step="0.1" min="0" max="90" required />
                            <span class="text-danger" asp-validation-for="Inclinacao"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Dificuldade"><strong>Dificuldade da Instalação: <span class="required">*</span></strong></label>
                            <button type="button" class="info-btn" data-toggle="tooltip" data-placement="top" title="Escolha o nível de dificuldade da instalação, considerando a estrutura do local.">?</button>

                            <select asp-for="Dificuldade" class="form-control" required>
                                <option value="">Escolha uma dificuldade</option>
                                @foreach (var dificuldade in Enum.GetValues(typeof(DificuldadeInstalacao)).Cast<DificuldadeInstalacao>())
                                {
                                    <option value="@dificuldade.ToString()">@dificuldade</option>
                                }
                            </select>
                            <span asp-validation-for="Dificuldade" class="text-danger"></span>
                        </div>

                        <div class="horizontal-button">
                            <a href="@Url.Action("Index", "Home")" class="btn">Cancelar</a>
                            <a href="@Url.Action("Simulation", "Tarifa")" class="btn">Anterior</a>
                            <button type="submit" class="btn">Calcular</button>
                        </div>
                    </form>
                </div>

                @if (ViewBag.Resultado != null)
                {
                    <div class="alert">@ViewBag.Resultado</div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>


          document.addEventListener('DOMContentLoaded', function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
             $(document).ready(function () {
            var consumoSelect = $("#consumoPainelSelect");

            consumoSelect.empty();

            $("#modeloPainelSelect").change(function () {
                var modeloPainelId = $(this).val();

                consumoSelect.empty();
                consumoSelect.append('<option value="">Nenhuma opção</option>');

                if (modeloPainelId) {
                    $.ajax({
                        url: "/DadosInstalacao/GetConsumosPainel",
                        type: "GET",
                        data: { modeloPainelId: modeloPainelId },
                        success: function (data) {
                            consumoSelect.empty();
                            consumoSelect.append('<option value="">Selecione uma potência</option>');
                            $.each(data, function (index, item) {
                                consumoSelect.append('<option value="' + item.id + '">' + item.potencia + ' W</option>');
                            });
                        },
                        error: function () {
                            consumoSelect.empty();
                            consumoSelect.append('<option value="">Erro ao carregar potência</option>');
                        }
                    });
                }
            });
        });
    </script>
}

<style>
    .create-container {
        height: 80vh;
        background-color: #f9f9f9;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .create-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 1500px;
    }

    .container {
        display: flex;
        width: 100%;
        min-height: 100vh;
    }

    .sidebar {
        width: 20%;
        background-color: #d3e1e3;
        padding: 20px;
        position: relative;
    }

    .steps {
        position: absolute;
        top: 50px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .step {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #aaa;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        margin: 30px 0;
        position: relative;
    }

    .step:first-child, .step:nth-child(2), .step:nth-child(3) {
        background-color: #065A66;
    }

    .step:first-child::after {
        background-color: #065A66;
    }


    .step:nth-child(2)::after {
        background-color: #065A66;
    }

    .step::after {
        content: "";
        width: 2px;
        height: 80px;
        background-color: #aaa;
        position: absolute;
        bottom: -80px;
        transform: translateX(-50%);
    }

    .step:last-child::after {
        display: none;
    }

    .content {
        width: 100%;
        padding: 20px;
    }

    h2 {
        font-weight: bold;
        font-size: 3rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #065A66;
        text-align: center;
        margin-bottom: 5%;
    }

    .left {
        margin-left: 3%;
    }

    .form-group {
        margin-bottom: 7%;
        width: 100%;
    }

    .form-control {
        width: 60%;
        padding: 8px;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    .btn {
        margin-top: 8%;
        background: #065A66;
        color: white;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
        border-radius: 10px;
        text-decoration: none;
        text-align: center;
    }

    .btn:hover {
        color: white;
        background: #054850;
    }

    .horizontal-button {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 3%;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        padding: 10px;
        border: 1px solid #f5c6cb;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .alert-danger ul {
        list-style-type: none;
        padding-left: 0;
    }

    .alert-danger li {
        margin-bottom: 5px;
    }

    .required {
        color: red;
        font-weight: bold;
    }

    .required-msg {
        font-size: 1rem;
        color: #065A66;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .info-btn {
        background: transparent;
        border: none;
        color: #065A66;
        font-size: 18px;
        cursor: pointer;
    }
</style>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.0/dist/js/bootstrap.bundle.min.js"></script>