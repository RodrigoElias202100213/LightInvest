@{
    ViewData["Title"] = "Home Page";
}

<div class="home-container">
    <!-- Barra de navegação -->
    <nav class="nav">
        <img src="~/images/logo.png" alt="LightInvest Logo" class="logo" />
        
        <div class="user-section">
            <p id="username">@ViewBag.UserName</p>
            @if (ViewBag.IsAdmin != null && ViewBag.IsAdmin == true)
            {
                <div class="btn-admin">
                    <a href="@Url.Action("UserList", "Home")" class="admin">Painel de Controlo</a>
                </div>
            }
            <a href="@Url.Action("Logout", "Account")" class="btn-logout">
                <img src="~/images/logout.png" alt="Logout" class="logout" />
            </a>
        </div>
    </nav>

    <!-- Sobre Nós -->
    <section class="about">
        <h1>Sobre Nós</h1>
        <p>O LightInvest combina análise financeira, simulações interativas e conteúdos educativos para ajudar indivíduos e empresas a investir de forma inteligente em energias renováveis.</p>
    </section>

    <!-- Opções principais -->
    <section class="container">
        <div class="box">
            <img src="~/images/roi.png" alt="Ícone ROI">
            <h3>Cálculo do ROI</h3>
            <p>Descubra a rentabilidade do seu investimento em painéis solares.</p>
            <form asp-controller="ROICalculator" asp-action="Index">
                <button type="submit" class="arrow-btn">
                    <img src="~/images/arrow.png" alt="Seta" class="arrow">
                </button>
            </form>
        </div>

        <div class="box">
            <img src="~/images/simulation.png" alt="Ícone Simulação">
            <h3>Simulação de Tarifas</h3>
            <p>Compare cenários tarifários e escolha a melhor solução.</p>
            <form asp-controller="EnergySimulation" asp-action="RedirectToEnergyView">
                <button type="submit" class="arrow-btn">
                    <img src="~/images/arrow.png" alt="Seta" class="arrow">
                </button>
            </form>
        </div>

        <div class="box">
            <img src="~/images/education.png" alt="Ícone Educação">
            <h3>Conteúdos Educativos</h3>
            <p>Explore artigos sobre energias renováveis e eficiência energética.</p>
            <form asp-controller="EducacaoEnergetica" asp-action="Index">
                <button type="submit" class="arrow-btn">
                    <img src="~/images/arrow.png" alt="Seta" class="arrow">
                </button>
            </form>
        </div>

    </section>
</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .home-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1.4;
    }

    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 10px 20px;
        background-color: #065A66;
    }

    .logo {
        height: 100px;
    }

    .user-section {
        display: flex;
        align-items: center;
        gap:4px;
    }

    #username {
        margin-top: 12%;
        margin-right: 8px;
        font-size: 12px;
        font-weight: bold;
        color: white;
        text-transform: uppercase;
    }

    .btn-admin{
        margin-top: 4%;
    }

    .admin, .admin:hover {
        color: white;
        text-decoration: none;
        margin-right: 8px;
        font-size: 12px;
        font-weight: bold;
        color: white;
        text-transform: uppercase;
        cursor:pointer;
    }

    .btn-logout {
        margin-top:3%;
    }

    .logout {
        height: 20px;
        cursor: pointer;
    }

    .about {
        text-align: center;
        margin: 30px 10px;
    }

    .about h1 {
        font-size: 3rem;
        margin-top: 10px;
        margin-bottom: 10px;
        color: black;
        letter-spacing: 1px;
        font-family: 'Alkatra', cursive;
    }

    .about p {
        font-size: 1rem;
        max-width: 700px;
        margin: auto;
        color: black;
        line-height: 1.4;
        font-weight: 300;
    }

    .container {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
        padding: 30px 10px;
    }

    .box {
        position:relative;
        width: 280px;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
        background-color: #D4E0E0;
        transition: transform 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: solid 1px black;
        cursor:pointer;
    }

    .box:hover {
        transform: translateY(-8px);
    }

    .box form {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .box img {
        max-width: 100%; 
        max-height: 50px;
        object-fit: contain; 
        margin-bottom: 10px;
    }

    .box h3 {
        font-size: 20px;
        margin-bottom: 8px;
        font-family: 'Salsa', cursive;
        color: black;
    }

    .box p {
        font-size: 16px;
        color: black;
        margin-bottom: 20%;
    }

    .arrow {
        position: relative;
        z-index: 1;
        margin-top: auto;
        cursor: pointer;
        transform: scale(0.3);
        display: block;
        margin-left: auto;
        margin-right: auto;
        height: 25px;
    }

    .box button {
        all: unset;
        display: inline-block;
        cursor: pointer;
        text-align: center;
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        margin-top:35%;
        /*opacity: 0;*/
    }

    button img {
        display: block;
        width: auto;
        height: auto;
    }

</style>