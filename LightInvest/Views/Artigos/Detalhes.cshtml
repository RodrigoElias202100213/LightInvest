@using LightInvest.Models.Educ.Artigos
@model Artigo
@using System.Linq
@using System.Security.Claims
@using Markdig

@{
    ViewData["Title"] = Model.Titulo;

}

<div class="container mt-4">
    <div class="row">
        <div class="container-header">
            <div class="header">
                <h2 class="title">@Model.Titulo</h2>
                <a href="@Url.Action("Index", "Artigos")" class="btn-anterior">
                    <img src="~/images/anterior.png" alt="Voltar" id="anterior" />
                </a>
            </div>
            <p class="text-muted">Publicado em: <strong>@Model.DataPublicacao.ToString("dd/MM/yyyy")</strong></p>
        </div>

        <div class="artigo-conteudo markdown-body">
            @Html.Raw(ViewBag.ConteudoHtml)
        </div>


        <div class="mt-5">
            <h4 class="text-muted">Artigos Relacionados</h4>
            <div class="row">
                @if (ViewBag.NoticiasRelacionadas != null && ViewBag.NoticiasRelacionadas.Count > 0)
                {
                    @foreach (var noticia in ViewBag.NoticiasRelacionadas)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                @if (!string.IsNullOrEmpty(noticia.Image))
                                {
                                    <img src="@noticia.Image" alt="Notícia Relacionada" class="card-img-top">
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@noticia.Title</h5>
                                    <p class="card-text">@noticia.Description</p>
                                    <a href="@noticia.Url" target="_blank" class="btn btn-secondary">Leia mais</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Nenhuma notícia encontrada sobre energia solar.</p>
                }
            </div>
        </div>

        <br />
        <hr />
        <br />

        <div class="mt-5">
            <h4 class="text-muted">Comentários</h4>

            <ul class="list-group">
                @foreach (var comentario in Model.Comentarios)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center comment-item">
                        <div>
                            <strong>@comentario.Autor</strong>
                            <small>@comentario.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small>
                            <p>@Html.Raw(Markdown.ToHtml(comentario.Texto))</p>

                            <button class="btn btn-light btn-sm me-2 like-btn @(comentario.liked ? "btn-success" : "")"
                                    data-comentario-id="@comentario.Id"
                                    data-action="@Url.Action("CurtirComentario", "Artigos")"
                                    title="Gostei">
                                <i class="fas fa-thumbs-up"></i>
                            </button>

                            <button class="btn btn-light btn-sm me-2 dislike-btn @(comentario.disliked ? "btn-danger" : "")"
                                    data-comentario-id="@comentario.Id"
                                    data-action="@Url.Action("RemoverCurtirComentario", "Artigos")"
                                    title="Não gostei">
                                <i class="fas fa-thumbs-down"></i>
                            </button>
                        </div>

                        <div class="d-flex">
                            @if (comentario.UserId == ViewBag.UtilizadorLogadoId)
                            {
                                <a href="@Url.Action("EditarComentario", new { comentarioId = comentario.Id, artigoId = Model.ArtigoId })" class="btn btn-warning btn-sm me-2">Editar</a>

                                <form asp-action="RemoverComentario" method="post" onsubmit="return confirm('Deseja realmente remover este comentário?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="comentarioId" value="@comentario.Id" />
                                    <input type="hidden" name="artigoId" value="@Model.ArtigoId" />
                                    <button type="submit" class="btn btn-danger btn-sm">Remover</button>
                                </form>
                            }
                            else if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
                            {
                                <form asp-action="RemoverComentario" method="post" onsubmit="return confirm('Deseja realmente remover este comentário?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="comentarioId" value="@comentario.Id" />
                                    <input type="hidden" name="artigoId" value="@Model.ArtigoId" />
                                    <button type="submit" class="btn btn-danger btn-sm">Remover</button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>

        <div class="mt-5">
            <h4 class="text-muted">Adicionar Comentário</h4>
            <form asp-action="AdicionarComentario" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="artigoId" value="@Model.ArtigoId" />

                <div class="form-group">
                    <label for="texto">Comentário:</label>
                    <textarea name="texto" id="texto" class="form-control" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Adicionar Comentário</button>
            </form>
        </div>

        <div class="mt-5 text-center">
            <a href="@Url.Action("Index", "EducacaoEnergetica")" class="btn btn-outline-dark">Voltar à Página Inicial</a>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        document.querySelectorAll('.like-btn, .dislike-btn').forEach(function(button) {
            button.addEventListener('click', function() {
                var comentarioId = this.getAttribute('data-comentario-id');
                var actionUrl = this.getAttribute('data-action');
                var actionType = this.classList.contains('like-btn') ? 'like' : 'dislike';

                updateButtons(comentarioId, actionType);

                fetch(actionUrl, {
                    method: 'POST',
                    body: new URLSearchParams({ comentarioId: comentarioId })
                }).then(response => response.json())
                  .then(data => {
                  }).catch(err => {
                      console.error('Erro ao processar a ação: ', err);
                  });
            });
        });

        function updateButtons(comentarioId, actionType) {
            let likeBtn = document.querySelector(`.like-btn[data-comentario-id='${comentarioId}']`);
            let dislikeBtn = document.querySelector(`.dislike-btn[data-comentario-id='${comentarioId}']`);

            if (actionType === 'like') {
                likeBtn.classList.add('btn-success');
                dislikeBtn.classList.remove('btn-danger');
            } else if (actionType === 'dislike') {
                dislikeBtn.classList.add('btn-danger');
                likeBtn.classList.remove('btn-success');
            }
        }
    </script>
}

<style>
    .header {
        display: flex;
        justify-content: space-between;
    }

    h2 {
        margin-top: 5%;
        font-size: 2.5rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #065A66;
        font-weight: bold;
        margin-bottom: 7%;
        border-bottom: 2px solid #065A66;
        display: inline-block;
        padding-bottom: 5px;
    }

    #anterior {
        transform: scale(0.1);
    }

    body {
        background-color: #f4f4f4;
        color: #333;
        font-family: Arial, sans-serif;
    }

    .container {
        max-width: 900px;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .btn-primary {
        background-color: #065A66;
        border-color: #065A66;
    }

    .btn-outline-primary {
        border-color: #065A66;
        color: #065A66;
    }

    .card {
        border-radius: 8px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
        background-color: #fff;
        height: 100%; 
        display: flex;
        flex-direction: column;
    }

    .card-img-top {
        height: 150px;
        object-fit: cover; 
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    .card-body {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card-title {
        font-size: 1rem;
        font-weight: bold;
        color: #333;
        height: 2.8em;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4em;
    }

    .card-text {
        font-size: 0.9rem;
        color: #666;
        flex-grow: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.3em;
        height: 3.9em;
    }

    .card .btn {
        margin-top: 10px;
        align-self: start;
    }

    .comment-item {
        background: #f8f9fa;
        border-left: 5px solid #065A66;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
    }

    .comment-item strong {
        color: #065A66;
    }

    .comment-item p {
        font-size: 0.9rem;
        color: #333;
    }

    .btn-sm {
        font-size: 0.8rem;
    }

    .btn-light {
        color: #333;
        border: 1px solid #ccc;
    }

    .btn-success {
        background-color: green;
    }

    .btn-danger {
        background-color: #d9534f;
    }

     .markdown-body {
        font-family: 'Segoe UI', sans-serif;
        font-size: 1rem;
        line-height: 1.8;
        color: #333;
    }

    .markdown-body h1, .markdown-body h2, .markdown-body h3 {
        color: #065A66;
        margin-top: 1.5em;
        margin-bottom: 0.5em;
    }

    .markdown-body h1 {
        font-size: 2rem;
        border-bottom: 2px solid #ddd;
    }

    .markdown-body h2 {
        font-size: 1.6rem;
        border-bottom: 1px solid #ccc;
    }

    .markdown-body h3 {
        font-size: 1.3rem;
    }

    .markdown-body p {
        margin: 1em 0;
    }

    .markdown-body ul {
        padding-left: 1.5rem;
        list-style-type: disc;
    }

    .markdown-body ol {
        padding-left: 1.5rem;
        list-style-type: decimal;
    }

    .markdown-body blockquote {
        border-left: 4px solid #065A66;
        background-color: #f9f9f9;
        padding: 10px 15px;
        color: #444;
        margin: 1em 0;
        font-style: italic;
    }

    .markdown-body a {
        color: #007BFF;
        text-decoration: underline;
        transition: color 0.2s ease;
    }

        .markdown-body a:hover {
            color: #0056b3;
        }

    .markdown-body code {
        background-color: #f4f4f4;
        padding: 2px 5px;
        border-radius: 4px;
        font-family: Consolas, monospace;
    }

    .markdown-body pre code {
        display: block;
        padding: 10px;
        background-color: #eee;
        overflow-x: auto;
    }

</style>
