@using LightInvest.Models.Educ.Artigos
@model Artigo
@using System.Linq
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1 class="display-4 text-center">@Model.Titulo</h1>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted">Publicado em: <strong>@Model.DataPublicacao.ToString("dd/MM/yyyy")</strong></p>
                <a href="@Url.Action("ListarPorCategoria", "Artigos", new { categoria = Model.Categoria })" class="btn btn-outline-primary btn-sm">Voltar à categoria</a>
            </div>

            <div class="card mb-4">
                @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                {
                    <img src="@Model.ImagemUrl" alt="Imagem do Artigo" class="card-img-top img-fluid rounded">
                }
            </div>

            <div class="content">
                <!-- Exibe o conteúdo convertido de Markdown para HTML -->
                <div class="lead">@Html.Raw(ViewBag.ConteudoHtml)</div>
            </div>

            <div class="mt-5">
                <h4 class="text-muted">Artigos Relacionados</h4>
                <div class="row">
                    @if (Model.ArtigosRelacionados != null && Model.ArtigosRelacionados.Any())
                    {
                        @foreach (var artigoRelacionado in Model.ArtigosRelacionados)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    @if (!string.IsNullOrEmpty(artigoRelacionado.ImagemUrl))
                                    {
                                        <img src="@artigoRelacionado.ImagemUrl" alt="Imagem Relacionada" class="card-img-top">
                                    }
                                    <div class="card-body">
                                        <h5 class="card-title">@artigoRelacionado.Titulo</h5>
                                        <p class="card-text">@artigoRelacionado.DescricaoCurta</p>
                                        <a href="@Url.Action("Detalhes", "Artigos", new { id = artigoRelacionado.ArtigoId })" class="btn btn-primary">Leia mais</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Não há artigos relacionados no momento.</p>
                    }
                </div>
            </div>
            <div class="mt-5">
                <h4 class="text-muted">Notícias sobre Energia Solar</h4>
                <div class="row">
                    @if (ViewBag.NoticiasRelacionadas != null && ViewBag.NoticiasRelacionadas.Count > 0)
                    {
                        @foreach (var noticia in ViewBag.NoticiasRelacionadas)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    @if (!string.IsNullOrEmpty(noticia.Image))
                                    {
                                        <img src="@noticia.Image" alt="Notícia Relacionada" class="card-img-top">
                                    }
                                    <div class="card-body">
                                        <h5 class="card-title">@noticia.Title</h5>
                                        <p class="card-text">@noticia.Description</p>
                                        <a href="@noticia.Url" target="_blank" class="btn btn-secondary">Leia mais</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Nenhuma notícia encontrada sobre energia solar.</p>
                    }
                </div>
            </div>
        </div>
        <ul class="list-group">
            @foreach (var comentario in Model.Comentarios)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center comment-item" style="cursor: pointer;">
                    <div>
                        <strong>@comentario.Autor</strong>
                        <p>@comentario.Texto</p>
                        <small>@comentario.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>

                    <!-- Verifica se o comentário é do usuário logado -->
                    @if (comentario.UserId == ViewBag.UsuarioLogadoId)
                    {
                        <a href="@Url.Action("EditarComentario", new { comentarioId = comentario.Id, artigoId = Model.ArtigoId })" class="btn btn-warning btn-sm">Editar</a>
                    }

                    @if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
                    {
                        <div class="admin-controls" style="display: none;">
                            <form asp-action="RemoverComentario" method="post" onsubmit="return confirm('Deseja realmente remover este comentário?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="comentarioId" value="@comentario.Id" />
                                <input type="hidden" name="artigoId" value="@Model.ArtigoId" />
                                <button type="submit" class="btn btn-danger btn-sm">Remover</button>
                            </form>
                        </div>
                    }
                </li>
           } 
        </ul>
            </div>

          <div class="mt-5">
    <h4 class="text-muted">Adicionar Comentário</h4>

    <!-- Formulário para adicionar novo comentário -->
    <form asp-action="AdicionarComentario" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="artigoId" value="@Model.ArtigoId" />

        <div class="form-group">
            <label for="texto">Comentário:</label>
            <textarea name="texto" id="texto" class="form-control" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Adicionar Comentário</button>
    </form>
</div>


            <div class="mt-5 text-center">
                <a href="@Url.Action("Index", "EducacaoEnergetica")" class="btn btn-outline-dark">Voltar à Página Inicial</a>
            </div>
        </div>
    </div>
</div>
    
@section Scripts {
    <script>
        // Para administradores, ao clicar em um comentário, alterna a exibição dos controles de remoção.
        document.querySelectorAll('.comment-item').forEach(function(item) {
            item.addEventListener('click', function(e) {
                // Evita disparar a ação se o clique foi no botão
                if (e.target.tagName.toLowerCase() === 'button') return;

                var adminControls = item.querySelector('.admin-controls');
                if (adminControls) {
                    adminControls.style.display = (adminControls.style.display === 'none' || adminControls.style.display === '')
                        ? 'block'
                        : 'none';
                }
            });
        });
    </script>
}
