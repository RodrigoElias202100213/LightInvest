@using LightInvest.Models.Educ.Artigos

@{
    ViewData["Title"] = "Artigos";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 text-center">
            <h1 class="display-4 mb-4">Artigos Educativos</h1>
            <p class="lead mb-4">Escolha um tema e descubra conteúdos incríveis!</p>

            <div class="d-grid gap-3 col-10 col-sm-8 col-md-6 mx-auto">
                <!-- Botões de categorias usando o Enum -->
                <a asp-controller="Artigos" asp-action="ListarPorCategoria" asp-route-categoria="@nameof(CategoriaArtigo.Energia_Renovavel)" class="btn btn-primary btn-lg py-3">
                    🌱 Energia Renovável
                </a>
                <a asp-controller="Artigos" asp-action="ListarPorCategoria" asp-route-categoria="@nameof(CategoriaArtigo.Principios_Basicos_painels)" class="btn btn-secondary btn-lg py-3">
                    🔆 Princípios de Painéis Solares
                </a>
                <a asp-controller="Artigos" asp-action="ListarPorCategoria" asp-route-categoria="@nameof(CategoriaArtigo.Calculo_ROI)" class="btn btn-success btn-lg py-3">
                    💰 Cálculo de ROI
                </a>
                <a asp-controller="Artigos" asp-action="ListarPorCategoria" asp-route-categoria="@nameof(CategoriaArtigo.Eficiencia_Energetica)" class="btn btn-warning btn-lg py-3">
                    ⚡ Eficiência Energética
                </a>
            </div>

            <!-- Botão de Voltar -->
            <div class="mt-4">
                <a asp-controller="EducacaoEnergetica" asp-action="Index" class="btn btn-outline-dark btn-lg">
                    ⬅ Voltar
                </a>
            </div>
        </div>
    </div>
</div>
