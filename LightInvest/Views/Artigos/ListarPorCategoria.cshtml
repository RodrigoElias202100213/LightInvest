@using LightInvest.Models.Educ.Artigos
@model List<Artigo>
@{
    ViewData["Title"] = "Artigos - " + ViewBag.Categoria;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 text-center">
            <h1 class="display-4 mb-4">Artigos sobre @ViewBag.Categoria</h1>

            @if (Model.Any())
            {
                <div class="list-group">
                    @foreach (var artigo in Model)
                    {
                        <div class="list-group-item mb-3 shadow-sm border-0 rounded">
                            <h5 class="mb-2">@artigo.Titulo</h5>
                            <p class="text-muted">@artigo.DescricaoCurta</p>
                            <a asp-controller="Artigos" asp-action="Detalhes" asp-route-id="@artigo.ArtigoId" class="btn btn-primary btn-lg">
                                📖 Ler Mais
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Ainda não há artigos disponíveis para este tema.</p>
            }

            <div class="mt-4">
                <a asp-controller="Artigos" asp-action="Index" class="btn btn-outline-dark btn-lg">⬅ Voltar</a>
            </div>
        </div>
    </div>
</div>
