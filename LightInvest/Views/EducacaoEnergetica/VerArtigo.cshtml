<div class="mt-5">
    <h4 class="text-muted">Artigos Relacionados</h4>
    <div class="row">
        @if (Model.ArtigosRelacionados != null && Model.ArtigosRelacionados.Any())
        {
            @foreach (var artigoRelacionado in Model.ArtigosRelacionados)
            {
                <div class="col-md-4 mb-3">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(artigoRelacionado.ImagemUrl))
                        {
                            <img src="@artigoRelacionado.ImagemUrl" alt="Imagem Relacionada" class="card-img-top">
                        }
                        <div class="card-body">
                            <h5 class="card-title">@artigoRelacionado.Titulo</h5>
                            <p class="card-text">@artigoRelacionado.DescricaoCurta</p>
                            <a href="@Url.Action("Detalhes", "Artigos", new { id = artigoRelacionado.ArtigoId })" class="btn btn-primary">Leia mais</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Não há artigos relacionados no momento.</p>
        }
    </div>
</div>
