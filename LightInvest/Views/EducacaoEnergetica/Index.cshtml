@{
    ViewData["Title"] = "Educação Energética";
}

<div class="home-container">
    <nav class="nav">
        <img src="~/images/logo.png" alt="LightInvest Logo" class="logo" />

        <div class="user-section">
            <p id="username">@ViewBag.UserName</p>
            @if (ViewBag.IsAdmin != null && ViewBag.IsAdmin == true)
            {
                <div class="btn-admin">
                    <a href="@Url.Action("UserList", "Home")" class="admin">Painel de Controlo</a>
                </div>
            }
            <a href="@Url.Action("Index", "Home")" class="btn-index"> Página Inicial </a>
            <a href="@Url.Action("Login", "Account")" class="btn-logout">
                <img src="~/images/logout.png" alt="Logout" class="logout" />
            </a>
        </div>
    </nav>

    <h2>Educação Energética</h2>
    <section class="container">
        <div class="box">
            <img src="~/images/artigos.png" alt="Ícone Manual Utilizador">
            <h3>Manual de Utilizador</h3>
            <p>Consulte o manual de utilizador caso tenha dúvidas sobre o funcionamento da nossa plataforma.</p>
            <form asp-controller="ManualTecnico" asp-action="Index">
                <button type="submit" class="arrow-btn">
                    <img src="~/images/arrow.png" alt="Seta" class="arrow">
                </button>
            </form>
        </div>
        <div class="box">
            <img src="~/images/artigos.png" alt="Ícone Artigos">
            <h3>Artigos</h3>
            <p>Explore artigos sobre energias renováveis, painéis solares, cálculo do ROI e eficiência energética.</p>
            <form asp-controller="Artigos" asp-action="Index">
                <button type="submit" class="arrow-btn">
                    <img src="~/images/arrow.png" alt="Seta" class="arrow">
                </button>
            </form>
        </div>
    </section>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .home-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #f4f4f4;
        text-align: center;
    }

    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 10px 20px;
        background-color: #065A66;
    }

    .logo {
        height: 80px;
    }

    .user-section {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    #username {
        margin-right: 8px;
        font-size: 12px;
        font-weight: bold;
        color: white;
        text-transform: uppercase;
        margin-top:5%;
    }


    .admin, .admin:hover {
        color: white;
        text-decoration: none;
        margin-right: 8px;
        font-size: 12px;
        font-weight: bold;
        color: white;
        text-transform: uppercase;
        cursor: pointer;
    }

    .btn-index, .btn-index:hover {
        font-size: 12px;
        font-weight: bold;
        color: white;
        text-transform: uppercase;
        text-decoration: none;
        margin-top:1%;
    }

    .btn-logout img {
        height: 25px;
        cursor: pointer;
    }

    h2 {
        margin-top: 5%;
        font-size: 2.3rem;
        color: black;
        font-family: 'Alkatra', cursive;
    }

    .container {
        display: flex;
        justify-content: center;
        gap: 40px;
        flex-wrap: wrap;
        padding: 30px 10px;
    }

    .box {
        position: relative;
        width: 300px;
        height: 290px;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
        background-color: #D4E0E0;
        transition: transform 0.3s ease;
        display: flex;
        flex-direction: column;
        border: solid 1px black;
        cursor: pointer;
    }

    .box:hover {
        transform: translateY(-8px);
    }

    .box img {
        max-width: 100%;
        max-height: 50px;
        object-fit: contain;
        margin-bottom: 20px;
        margin-top: 10px;
    }


    .box h3 {
        margin-top: 0;
        font-size: 22px;
        margin-bottom: 12px;
        font-family: 'Salsa', cursive;
        color: black;
    }

    .box p {
        font-size: 16px;
        color: black;
        margin-bottom: 2%;
    }

    .arrow {
        position: relative;
        z-index: 1;
        margin-top: 0;
        cursor: pointer;
        transform: scale(0.3);
        display: block;
        margin-left: auto;
        margin-right: auto;
        height: 25px;
    }

    .box button {
        all: unset;
        display: inline-block;
        cursor: pointer;
        text-align: center;
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        margin-top: 35%;
    }
</style>